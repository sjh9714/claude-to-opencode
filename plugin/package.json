{
  "name": "dsh-movein-permissions",
  "version": "0.2.7",
  "description": "Fine grained per tool permission rules for DeepSeek Harness (DSH). deny/ask lists in Claude Code rule syntax, enforced at the tools/pre-execute gate. Works standalone.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permissions",
    "claude-code",
    "allowlist",
    "security",
    "permission-gate"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sjh9714/dsh-movein.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/sjh9714/dsh-movein/tree/main/plugin#readme",
  "bugs": {
    "url": "https://github.com/sjh9714/dsh-movein/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0",
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  }
}
